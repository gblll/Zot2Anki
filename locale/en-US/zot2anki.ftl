zot2anki-menu-export =
    .label = Export Anki Vocabulary…

zot2anki-preferences-heading = Vocabulary highlight filter
zot2anki-preferences-color-label = Highlight color
zot2anki-preferences-color-description = Only highlights whose color exactly matches this value are exported. The default is Zotero red (#ff6666).
zot2anki-preferences-keyword-label = Annotation tag keyword
zot2anki-preferences-keyword-description = A highlight is exported when at least one of its own tags contains this text. Parent-item tags are not inherited.
